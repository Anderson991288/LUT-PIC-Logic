    },
    {
      "index": 3,
      "name": "o3",
      "layout_port": "out2",
      "role": "終端"
    },
    {
      "index": 4,
      "name": "o4",
      "layout_port": "out3",
      "role": "判讀"
    },
    {
      "index": 5,
      "name": "o5",
      "layout_port": "out4",
      "role": "終端"
    }
  ],
  "mzis": [
    {
      "name": "MZI-1",
      "waveguides": [
        1,
        2
      ],
      "layer": 1,
      "theta": "θ1",
      "phi": "φ1"
    },
    {
      "name": "MZI-2",
      "waveguides": [
        4,
        5
      ],
      "layer": 1,
      "theta": "θ2",
      "phi": "φ2"
    },
    {
      "name": "MZI-3",
      "waveguides": [
        2,
        3
      ],
      "layer": 2,
      "theta": "θ3",
      "phi": "φ3"
    },
    {
      "name": "MZI-4",
      "waveguides": [
        1,
        2
      ],
      "layer": 3,
      "theta": "θ4",
      "phi": "φ4"
    },
    {
      "name": "MZI-5",
      "waveguides": [
        3,
        4
      ],
      "layer": 3,
      "theta": "θ5",
      "phi": "φ5"
    },
    {
      "name": "MZI-6",
      "waveguides": [
        2,
        3
      ],
      "layer": 4,
      "theta": "θ6",
      "phi": "φ6"
    },
    {
      "name": "MZI-7",
      "waveguides": [
        4,
        5
      ],
      "layer": 4,
      "theta": "θ7",
      "phi": "φ7"
    }
  ],
  "order": "光由左到右；U＝T̂7·T̂6·…·T̂1（同一層的兩顆可交換）",
  "mzi_convention": {
    "matrix": "T(θ, φ)＝H·diag(e^{iθ}, 1)·H·diag(e^{iφ}, 1)，H＝[[1, i], [i, 1]]/√2",
    "ports": "每顆 MZI 的第 1 列／行＝上方波導（編號較小），第 2 列／行＝下方波導",
    "phases": "θ：兩顆 MMI 之間、上臂；φ：第一顆 MMI 之前、上臂；單位 rad"
  },
  "readout": {
    "ports": [
      "o2",
      "o4"
    ],
    "rule": "ΔP＝P(o2) − P(o4)；ΔP＞0 判 1，ΔP＜0 判 0，ΔP＝0 為邊界（判讀失敗）"
  },
  "model": "理想、無損耗、相干輸入、單一波長"
}

      "signal": "x3",
      "layout_port": "in2",
      "amplitude": "0／1（√P_u）"
    },
    {
      "index": 4,
      "signal": "x4",
      "layout_port": "in3",
      "amplitude": "0／1（√P_u）"
    },
    {
